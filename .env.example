ANTHROPIC_API_KEY=(ここにClaudeのAPIキーを。サブスクログインで使う場合は不要)

# --- Discord Bot 用 ---
# Developer Portal で発行した Bot トークン
DISCORD_TOKEN=(ここにBotトークンを)
# 隼のDiscordユーザーID(数値)。Discordの開発者モードをONにし、自分を右クリック→「IDをコピー」で取得
DISCORD_OWNER_ID=(ここにユーザーIDを)

# --- HTTPS(Tailscale公開時のみ) ---
# 証明書と鍵の両方をセットするとHTTPSで起動する。空のままならHTTPで起動
SSL_CERTFILE=
SSL_KEYFILE=

# --- ポート(省略時は8000) ---
PORT=8000